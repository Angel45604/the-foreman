    "summary": { "type": "string", "minLength": 1 },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "class": { "type": "string", "enum": ["agent_fixable", "decision"] },
          "severity": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
          "file": { "type": "string" },
